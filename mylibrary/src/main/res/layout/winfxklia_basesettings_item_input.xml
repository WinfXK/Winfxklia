<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:padding="@dimen/winfxkliaBaseSettingsItemPS"
        android:background="?android:attr/selectableItemBackground"
        android:layout_height="@dimen/winfxkliaBaseSettingsItemHeight">

    <TextView
            android:gravity="center_vertical"
            android:textStyle="bold"
            android:textColor="@color/winfxklia_black"
            android:text="@string/winfxklia_app_name"
            android:id="@+id/textView1"
            android:textSize="@dimen/winfxkliaBaseSettingsItemTitleTextSize"
            android:layout_width="match_parent"
            android:layout_height="@dimen/winfxkliaBaseSettingsItemHeight" />

    <EditText
            android:layout_alignParentEnd="true"
            android:id="@+id/editText1"
            android:hint="@string/winfxklia_empty"
            android:labelFor="@id/textView1"
            android:layout_width="wrap_content"
            android:inputType="text"
            android:minWidth="@dimen/winfxkliaBaseSettingsItemValueMinWidth"
            android:textSize="@dimen/winfxkliaBaseSettingsItemTitleTextSize"
            android:layout_height="@dimen/winfxkliaBaseSettingsItemHeight" />
</RelativeLayout>